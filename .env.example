# Copy to .env (at this same repo-root level, next to docker-compose.yml) to have Docker
# Compose fill in the ${VAR:-default} placeholders in that file automatically on every
# `docker compose up`/`--build` — Compose auto-loads a `.env` file from the directory the
# compose file itself lives in; a shell `export` or `VAR=value docker compose up` works too,
# and takes priority over this file.
#
# This is a *different* .env from src/backend-argus/.env: that one is only read when you run
# backend-argus's own standalone docker-compose.yml (which has an explicit `env_file:` line) or
# `uvicorn app.main:app` directly on the host — the root docker-compose.yml here doesn't read
# it, so setting a variable in src/backend-argus/.env has no effect on `docker compose up` run
# from this directory. Keep both in sync manually if you want the same values either way.

MONGO_DB=argus
JWT_SECRET=dev-secret-change-me
CORS_ORIGINS=http://localhost:5173

# First root_admin, auto-created on startup if missing (src/backend-argus/app/auth/bootstrap.py).
ROOT_ADMIN_EMAIL=admin@argus.dev
ROOT_ADMIN_PASSWORD=changeme123
ROOT_ADMIN_FIRST_NAME=Root
ROOT_ADMIN_LAST_NAME=Admin
ROOT_ADMIN_PHONE_NUMBER=+00-000-0000

# When true, idempotently seeds a demo fleet (admin/operator + guardian accounts, trucks,
# drivers, routes — see src/backend-argus/scripts/seed_dev_data.py) on every backend startup.
# Safe to leave on permanently in local dev. Never set true in a real deployment.
SEED_DEMO_DATA=false

# Read by the *browser*, not the ui-argus container — must be host-reachable, not the Docker
# network hostname `backend-argus`.
VITE_API_BASE_URL=http://localhost:8000
