# Copy to .env for local (non-Docker) runs. docker-compose.yml has its own checked-in
# defaults for the same variables (see that file's `environment:` block) so `docker compose up`
# works with no .env at all — this file matters mainly for `uvicorn app.main:app --reload`
# run directly on the host.

# Mongo connection. In docker-compose.yml this points at the `mongo` service by hostname;
# outside Docker, point it at wherever mongod is actually listening.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=argus

# HS256 signing secret for access tokens (app/auth/security.py). There's no rotation story
# yet — changing this invalidates every outstanding token. Generate one with, e.g.,
# `python -c "import secrets; print(secrets.token_hex(32))"` — the value below is a
# placeholder, never use it past local dev.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=480

# Comma-separated list of origins the browser SPA is allowed to call this API from.
CORS_ORIGINS=http://localhost:5173

# The first root_admin, auto-created on startup if no user exists at this email yet
# (app/auth/bootstrap.py) — otherwise there's no way to get an initial admin into a real
# deployment at all. ROOT_ADMIN_PASSWORD is the *raw* password (same as a human types into the
# login form), not a digest — the backend runs it through the same sha256-then-bcrypt pipeline a
# real browser login would. The values below match scripts/seed_dev_data.py's own dev
# credentials on purpose; never use them past local dev.
ROOT_ADMIN_EMAIL=admin@argus.dev
ROOT_ADMIN_PASSWORD=changeme123
ROOT_ADMIN_FIRST_NAME=Root
ROOT_ADMIN_LAST_NAME=Admin
ROOT_ADMIN_PHONE_NUMBER=+00-000-0000
