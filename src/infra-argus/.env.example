# Copy to `.env` (same folder) and fill in. `.env` is gitignored — never commit it.
#
# Used only on YOUR machine by:
#   npm run setup-secrets  -> pushes the secrets below to AWS SSM Parameter Store (encrypted)
#   npm run deploy         -> reads AWS_REGION / ROOT_ADMIN_EMAIL / ALERT_EMAIL
# The deployed backend never reads this file; it loads the secrets from SSM at startup.

# --- AWS -------------------------------------------------------------------------------
AWS_REGION=us-east-1
# AWS_PROFILE=default

# --- Secrets (go to SSM via `npm run setup-secrets`) ------------------------------------
# Atlas: Connect -> Drivers. Letters/numbers-only password avoids URL-escaping problems.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Any long random string: openssl rand -hex 32
JWT_SECRET=
# The password you'll log in with as root_admin (the simulator uses it too).
ROOT_ADMIN_PASSWORD=

# --- Not secret (passed to `cdk deploy`) ------------------------------------------------
ROOT_ADMIN_EMAIL=admin@argus.dev
# Budget / kill-switch alert emails go here (leave empty to skip email alerts).
ALERT_EMAIL=
