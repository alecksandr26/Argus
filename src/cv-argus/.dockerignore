__pycache__/
*.pyc
*.pyo
.pytest_cache/
.git
.env
# tests/ now IS needed in the build context — the Dockerfile's `test` stage COPYs it in to run
# the hermetic pytest suite as a build gate (see that stage's comment). Editing a test file now
# does bust the Docker layer cache from that COPY onward — that's the intended behavior, not a
# regression: it's exactly what forces the gate to actually re-run.
.venv/
models/
*.keras
*.task
# scripts/output/ is local dataset-extraction output (gitignored, can reach double-digit GB) —
# nothing in the Dockerfile ever COPYs `scripts/` in at all, so leaving it un-ignored here was
# only bloating `Sending build context to Docker daemon` for no reason.
scripts/output/
