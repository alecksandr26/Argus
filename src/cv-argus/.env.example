# Copy to .env and fill in. .env is gitignored — never commit real values.

# Google Drive file IDs of the parts detector (notebook 12's tiny_yolo_w1), int8 .tflite and
# float .keras. Both have checked-in defaults in src/constants.py, so leaving these blank is
# fine; set them only to point at a newer trained model without a code change. Get an id from
# the shareable link https://drive.google.com/file/d/<THIS_PART_IS_THE_ID>/view; the file must
# be shared "Anyone with the link" (Viewer) for gdown to fetch it.
PARTS_INT8_DRIVE_FILE_ID=
PARTS_FLOAT_DRIVE_FILE_ID=

# Detector precision (int8 = default, float = the original .keras) and the decision thresholds
# for open/closed eyes and straight/down head (0.5 = argmax, lower = more sensitive; blank = the
# src/constants.py defaults 0.40 / 0.30). Rule timers are RULE_* (see src/constants.py), e.g.
# RULE_EYES_CRITICAL_S=2.5.
PARTS_PRECISION=int8
# If the int8 model can't load or run on this device (seen on a Pi 5), fall back to the float
# .keras automatically (1, default) or fail at startup (0).
PARTS_INT8_FALLBACK=1
PARTS_CLOSED_EYE_THRESHOLD=
PARTS_HEAD_DOWN_THRESHOLD=

# Where the container caches downloaded models (matches the Dockerfile's VOLUME).
MODEL_DIR=/app/models

# Camera source for cv2.VideoCapture: an integer index (0 = first camera), a /dev/videoN
# path, or a video file path (for offline testing without any camera attached, or as a
# zero-hardware-risk demo fallback).
CAMERA_SOURCE=0

# Where frames come from: "video_capture" (default -- cv2.VideoCapture, driven by
# CAMERA_SOURCE above) or "picamera" (the Pi 5's CSI camera via picamera2 -- see
# docker-compose.pi.yml, not this file's plain `docker compose up`).
SOURCE=video_capture

# Comma-separated output sink(s) src/main.py attaches to the inference stage: "logging"
# (default, one text line per frame), "metrics" (one JSON line per frame with every timing, to
# METRICS_LOG_PATH, default $BUFFER_DIR/metrics.jsonl -- summarise it with
# scripts/summarize_metrics.py) and/or "mjpeg" (a browser-viewable annotated video stream for
# demos -- e.g. OUTPUTS=logging,metrics,mjpeg). The mjpeg stream has NO authentication -- demo-only, don't leave
# it set in a real deployment (see pipeline/mjpeg_output_stage.py's module docstring for why).
OUTPUTS=logging

# Frames/sec sampled from the camera, decimated at the source (skipped frames aren't decoded).
# Default 5 = the rate the rule timers and the tracker's miss/vote windows are tuned for
# (src/constants.py DEFAULT_SAMPLE_FPS). 0 = process every frame.
SAMPLE_FPS=5

# --- Raspberry Pi 5 resource simulation (docker-compose.yml applies these by default) --------
# CV_ARGUS_NUM_THREADS pins BLAS/OpenMP/TensorFlow/OpenCV thread pools (see cv_argus/bootstrap.py).
# CV_ARGUS_CPUSET / CV_ARGUS_CPUS / CV_ARGUS_MEM are the container's cgroup limits. Defaults
# simulate a 4-core / 8 GB Pi 5. For an unthrottled dev run, uncomment and widen:
# CV_ARGUS_NUM_THREADS=12
# CV_ARGUS_CPUSET=0-11
# CV_ARGUS_CPUS=12
# CV_ARGUS_MEM=32g

# Diagnostics. LATENCY_LOG_INTERVAL is the seconds between per-stage StageStats report lines
# (process time, input-queue depth, dropped-frame count, and end-to-end latency at the sink --
# see cv_argus/pipeline/latency.py and the README's "Finding the bottleneck"). 0 disables them.
# LOG_LEVEL=DEBUG additionally surfaces the drop-oldest debug logs.
LATENCY_LOG_INTERVAL=10
LOG_LEVEL=INFO

# Only read when OUTPUTS includes "mjpeg". DEMO_STREAM_HOST should normally stay 0.0.0.0 inside
# the container (needed for the docker-compose.yml port mapping to reach it at all); change
# DEMO_STREAM_PORT if 8080 is already taken on your machine.
DEMO_STREAM_HOST=0.0.0.0
DEMO_STREAM_PORT=8080

# Where buffer/'s SQLite file (queued/unsent alerts) lives — matches the Dockerfile's
# BUFFER_DIR volume. Not a database server to configure, just a file path: sqlite3 opens it
# directly from within the same container process.
BUFFER_DIR=/app/data
BUFFER_DB_FILENAME=buffer.sqlite3

# sender/'s Bluetooth SPP server: "bluetooth" (real BluetoothSppListener, needs a real adapter
# + device passthrough neither compose file wires up yet) or "none" (no SenderServer at all --
# alerts/route-status heartbeats just accumulate unsent in buffer/, nothing is lost). docker-
# compose.yml's own default is "none" for exactly this reason -- see its SENDER_TRANSPORT
# comment and src/cv-argus/CLAUDE.md's "Open decisions" before setting this to "bluetooth".
SENDER_TRANSPORT=none
# Only read when SENDER_TRANSPORT=bluetooth: the RFCOMM channel BluetoothSppListener binds.
BLUETOOTH_CHANNEL=4
