# Copy to .env and fill in. .env is gitignored — never commit real values.

# Google Drive file ID of the trained end-to-end model
# (lstm_geometric_feature_model_<VERSION>.keras from the notebook's "Saving the Geometric
# rate feature layer + LSTM Model" step). Get it from the shareable link:
#   https://drive.google.com/file/d/<THIS_PART_IS_THE_ID>/view
# The file's sharing setting must be "Anyone with the link" (Viewer) for gdown to fetch it
# without extra credentials.
MODEL_DRIVE_FILE_ID=

# Where the container caches the downloaded model (matches the Dockerfile's VOLUME).
MODEL_DIR=/app/models
MODEL_FILENAME=lstm_geometric_feature_model.keras

# Camera source for cv2.VideoCapture: an integer index (0 = first camera), a /dev/videoN
# path, or a video file path (for offline testing without any camera attached).
CAMERA_SOURCE=0

# Where buffer/'s SQLite file (queued/unsent alerts) lives — matches the Dockerfile's
# BUFFER_DIR volume. Not a database server to configure, just a file path: sqlite3 opens it
# directly from within the same container process.
BUFFER_DIR=/app/data
BUFFER_DB_FILENAME=buffer.sqlite3
