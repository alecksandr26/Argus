# Copy to .env and fill in. .env is gitignored — never commit real values.

# Google Drive file ID of the CNN checkpoint (cnn_face_crop_model.keras from
# notebook/07_cnn_training.ipynb). Not run for its own classification — kept as the frozen
# embedding backbone the deployed fused model depends on (see src/cv-argus/CLAUDE.md's "Current
# status"). Has a checked-in default in src/constants.py, so leaving this blank is fine; set it
# only to point at a different/newer trained model without a code change. Get the id from the
# shareable link:
#   https://drive.google.com/file/d/<THIS_PART_IS_THE_ID>/view
# The file's sharing setting must be "Anyone with the link" (Viewer) for gdown to fetch it
# without extra credentials.
CNN_MODEL_DRIVE_FILE_ID=

# Google Drive file ID of the trained fused CNN-embedding + geometric-feature + LSTM classifier
# (best_cnn_lstm_frozen_embedding.keras from notebook/11_cnn_lstm_training_drive_pull.ipynb) —
# the model this container deploys: 84.24% test accuracy / 0.8375 macro-F1, the best measured
# result in the project, though not yet cross-validated — see src/cv-argus/CLAUDE.md's "Current
# status" before treating it as production-ready. Has a checked-in default in src/constants.py,
# so leaving this blank is fine; set it only to point at a different/newer trained model without
# a code change.
FUSED_MODEL_DRIVE_FILE_ID=

# Where the container caches downloaded models (matches the Dockerfile's VOLUME).
MODEL_DIR=/app/models
CNN_MODEL_FILENAME=cnn_face_crop_model.keras
FUSED_MODEL_FILENAME=best_cnn_lstm_frozen_embedding.keras

# Camera source for cv2.VideoCapture: an integer index (0 = first camera), a /dev/videoN
# path, or a video file path (for offline testing without any camera attached, or as a
# zero-hardware-risk demo fallback).
CAMERA_SOURCE=0

# Where frames come from: "video_capture" (default -- cv2.VideoCapture, driven by
# CAMERA_SOURCE above) or "picamera" (the Pi 5's CSI camera via picamera2 -- see
# docker-compose.pi.yml, not this file's plain `docker compose up`).
SOURCE=video_capture

# Comma-separated output sink(s) src/main.py attaches to the inference stage: "logging"
# (default, text only) and/or "mjpeg" (a browser-viewable annotated video stream for demos --
# e.g. OUTPUTS=logging,mjpeg). The mjpeg stream has NO authentication -- demo-only, don't leave
# it set in a real deployment (see pipeline/mjpeg_output_stage.py's module docstring for why).
OUTPUTS=logging

# Frames/sec sampled from the camera, decimated at the source (skipped frames aren't decoded).
# Default 5 = the model's training rate (src/constants.py DEFAULT_SAMPLE_FPS); running faster
# feeds the LSTM's 100-frame window at a denser rate than training. 0 = process every frame.
SAMPLE_FPS=5

# --- Raspberry Pi 5 resource simulation (docker-compose.yml applies these by default) --------
# CV_ARGUS_NUM_THREADS pins BLAS/OpenMP/TensorFlow/OpenCV thread pools (see cv_argus/bootstrap.py).
# CV_ARGUS_CPUSET / CV_ARGUS_CPUS / CV_ARGUS_MEM are the container's cgroup limits. Defaults
# simulate a 4-core / 8 GB Pi 5. For an unthrottled dev run, uncomment and widen:
# CV_ARGUS_NUM_THREADS=12
# CV_ARGUS_CPUSET=0-11
# CV_ARGUS_CPUS=12
# CV_ARGUS_MEM=32g

# Diagnostics. LATENCY_LOG_INTERVAL is the seconds between per-stage StageStats report lines
# (process time, input-queue depth, dropped-frame count, and end-to-end latency at the sink --
# see cv_argus/pipeline/latency.py and the README's "Finding the bottleneck"). 0 disables them.
# LOG_LEVEL=DEBUG additionally surfaces LoggingOutputStage's per-frame lines and the
# drop-oldest debug logs.
LATENCY_LOG_INTERVAL=10
LOG_LEVEL=INFO

# Only read when OUTPUTS includes "mjpeg". DEMO_STREAM_HOST should normally stay 0.0.0.0 inside
# the container (needed for the docker-compose.yml port mapping to reach it at all); change
# DEMO_STREAM_PORT if 8080 is already taken on your machine.
DEMO_STREAM_HOST=0.0.0.0
DEMO_STREAM_PORT=8080

# Where buffer/'s SQLite file (queued/unsent alerts) lives — matches the Dockerfile's
# BUFFER_DIR volume. Not a database server to configure, just a file path: sqlite3 opens it
# directly from within the same container process.
BUFFER_DIR=/app/data
BUFFER_DB_FILENAME=buffer.sqlite3
