# Copy this file to .env before running `docker compose up` (docker-compose.yml expects
# one to exist, even though nothing here is required yet).
#
# Vite only exposes env vars prefixed VITE_ to client code (import.meta.env.VITE_*) —
# anything without that prefix is invisible to the browser bundle by design, so don't
# rename this away from the prefix expecting it to "just work".

# Base URL of the FastAPI backend (see the top-level CLAUDE.md's "Planned end-to-end
# system architecture"). That backend doesn't exist yet, so this is unused for now —
# kept here so the wiring point is obvious once it does.
VITE_API_BASE_URL=http://localhost:8000
