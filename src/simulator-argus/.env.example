# Copy to .env for local (non-Docker) runs. Every var has a dev-safe default in config.py, so
# none of this is required to get started -- see README.md's config table.

# Docker-network hostname by default; use http://localhost:8000 (or whichever port your compose
# maps) when running this module against a host-run backend instead of inside Compose.
BACKEND_BASE_URL=http://backend-argus:8000

# root_admin credentials used ONLY once at startup, to provision the SIM-* fleet and mint each
# truck's own device API key. Must match backend-argus's own ROOT_ADMIN_EMAIL/ROOT_ADMIN_PASSWORD.
SIMULATOR_ADMIN_EMAIL=admin@argus.dev
SIMULATOR_ADMIN_PASSWORD=changeme123

SIMULATOR_TRUCK_COUNT=4
SIMULATOR_STATUS_INTERVAL_SECONDS=5
SIMULATOR_RESET=true

# Wall-clock length of a simulated trip -- from a few minutes (fast demo) to several hours (a
# realistic shift). Movement always advances by elapsed-time-fraction of this window.
SIMULATOR_ROUTE_DURATION_MINUTES=20

# Per-truck scenario profile is drawn at random, weighted by these proportions. Unknown names
# or malformed entries are dropped; if nothing valid parses, falls back to an equal split.
SIMULATOR_SCENARIO_WEIGHTS=normal=0.55,drowsy_escalation=0.25,panic=0.20

# Baseline chance of a "medium" vigilance blip on an otherwise-quiet tick.
SIMULATOR_MEDIUM_BLIP_PROBABILITY=0.1

# Off by default -- needs a one-time setup step first (./scripts/setup_osrm.sh), see README's
# "Optional: real road-following routes via OSRM". Falls back to a straight line per route if
# OSRM is unreachable or the extract isn't preprocessed yet, even when this is true.
SIMULATOR_USE_OSRM=false
OSRM_BASE_URL=http://osrm:5000
