# Copy to .env for local (non-Docker) runs. Every var has a dev-safe default in config.py, so
# none of this is required to get started -- see README.md's config table.

# Docker-network hostname by default; use http://localhost:8000 (or whichever port your compose
# maps) when running this module against a host-run backend instead of inside Compose.
BACKEND_BASE_URL=http://backend-argus:8000

# root_admin credentials used ONLY once at startup, to provision the SIM-* fleet and mint each
# truck's own device API key. Must match backend-argus's own ROOT_ADMIN_EMAIL/ROOT_ADMIN_PASSWORD.
SIMULATOR_ADMIN_EMAIL=admin@argus.dev
SIMULATOR_ADMIN_PASSWORD=changeme123

SIMULATOR_TRUCK_COUNT=6
# Points-only report cadence (an event goes at once); one GPS point is read every second.
SIMULATOR_REPORT_INTERVAL_S=5
SIMULATOR_RESET=true

# Wall-clock length of a simulated trip -- from a few minutes (fast demo) to several hours (a
# realistic shift). Movement always advances by elapsed-time-fraction of this window.
SIMULATOR_ROUTE_DURATION_MINUTES=20

# Per-truck scenario profile is drawn at random, weighted by these proportions. Unknown names
# or malformed entries are dropped; if nothing valid parses, falls back to an equal split.
SIMULATOR_SCENARIO_WEIGHTS=normal=0.45,drowsy_escalation=0.35,no_face=0.20

# Chance (0..1) that a `normal` route gets its one head_down medium blip, at a random time in the
# route. A medium keeps the route's map colour until a guardian closes it, so `normal` gets at
# most one: at 0.5 about half of the normal routes stay fine all the way. (Replaces the retired
# per-5-s SIMULATOR_MEDIUM_BLIP_PROBABILITY, which is now ignored with a warning.)
SIMULATOR_NORMAL_BLIP_CHANCE=0.5

# Optional demo disruptions, chance per route of one of each (0 = off, the default).
# Outage: 70-150 s of failed reports (no_network), so a critical goes to the dead-letter queue
# and is replayed afterwards ("Recovered after lost connection"). GPS loss: 30-90 s of
# last-known positions ("Last known (N old)").
SIMULATOR_OUTAGE_CHANCE=0
SIMULATOR_GPS_LOSS_CHANCE=0

# On by default -- needs a one-time setup step first (./scripts/setup_osrm.sh), see README's
# "Optional: real road-following routes via OSRM", before it actually takes effect. Falls back
# to a straight line per route if OSRM is unreachable or the extract isn't preprocessed yet.
SIMULATOR_USE_OSRM=true
OSRM_BASE_URL=http://osrm:5000
